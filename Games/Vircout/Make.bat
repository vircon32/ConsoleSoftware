@echo off
REM Generated by v32lua 20261018-dev for vircout.lua.
REM Edit freely: v32lua leaves a Make.bat it did not write alone, and
REM --no-build-scripts stops it writing these.
cd /d "%~dp0"

REM v32lua is needed to build this project
where v32lua >nul 2>nul
if errorlevel 1 (
    echo.
    echo ERROR: v32lua is needed to build this project, but it was not found in your PATH
    goto :failed
)

REM create the output folders if non existing, since
REM the development tools will not create them themselves
if not exist obj mkdir obj
if not exist bin mkdir bin

echo.
echo Compile the Lua code
echo --------------------------
v32lua --no-build-scripts -o obj\vircout.asm vircout.lua || goto :failed

echo.
echo Convert the PNG textures
echo --------------------------
png2vircon assets\sprites.png -o obj\sprites.vtex || goto :failed
png2vircon assets\title.png -o obj\title.vtex || goto :failed
png2vircon assets\gameplay.png -o obj\gameplay.vtex || goto :failed
png2vircon assets\ending.png -o obj\ending.vtex || goto :failed

echo.
echo Convert the WAV sounds
echo --------------------------
wav2vircon audio\music_title.wav -o obj\music_title.vsnd || goto :failed
wav2vircon audio\music_gameplay.wav -o obj\music_gameplay.vsnd || goto :failed
wav2vircon audio\music_ending.wav -o obj\music_ending.vsnd || goto :failed
wav2vircon audio\sfx_paddle.wav -o obj\sfx_paddle.vsnd || goto :failed
wav2vircon audio\sfx_wall.wav -o obj\sfx_wall.vsnd || goto :failed
wav2vircon audio\sfx_normal.wav -o obj\sfx_normal.vsnd || goto :failed
wav2vircon audio\sfx_hard_hit.wav -o obj\sfx_hard_hit.vsnd || goto :failed
wav2vircon audio\sfx_hard_break.wav -o obj\sfx_hard_break.vsnd || goto :failed
wav2vircon audio\sfx_metal.wav -o obj\sfx_metal.vsnd || goto :failed
wav2vircon audio\sfx_item.wav -o obj\sfx_item.vsnd || goto :failed
wav2vircon audio\sfx_laser.wav -o obj\sfx_laser.vsnd || goto :failed
wav2vircon audio\sfx_ball_lost.wav -o obj\sfx_ball_lost.vsnd || goto :failed
wav2vircon audio\sfx_level_clear.wav -o obj\sfx_level_clear.vsnd || goto :failed
wav2vircon audio\sfx_game_over.wav -o obj\sfx_game_over.vsnd || goto :failed
wav2vircon audio\sfx_cheat.wav -o obj\sfx_cheat.vsnd || goto :failed

echo.
echo Assemble the ASM code
echo --------------------------
assemble obj\vircout.asm -o obj\vircout.vbin || goto :failed

echo.
echo Pack the ROM
echo --------------------------
packrom obj\vircout.xml -o bin\Vircout.v32 || goto :failed
goto :succeeded

:failed
echo.
echo BUILD FAILED
exit /b 1

:succeeded
echo.
echo BUILD SUCCESSFUL
exit /b 0
